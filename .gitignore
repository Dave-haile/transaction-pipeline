# Rust build artifacts
/target/
crates/*/target/

# App runtime config - local per-machine, never committed
.env

# Compose build-arg overrides - VM/company-network-specific
docker/.env

# The VM's own CA bundle, copied in only for the corporate-network
# workaround. Regenerate locally if you actually need this path.
docker/base-images/ca-certificates.crt

# Auto-(re)generated by the ClickHouse container's entrypoint on every
# start - not something we author, shouldn't be version-controlled.
docker/clickhouse/users.d/default-user.xml